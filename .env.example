# =============================================================================
# E-Watu local dev — environment reference (NOT auto-loaded)
# =============================================================================
# NestJS loads .env from each service folder only. Copy sections below into
# the matching file. These three values MUST be identical everywhere noted:
#
#   JWT_PRIVATE_KEY=...   (identity-service only — RS256 PEM, use \n for newlines)
#   JWT_PUBLIC_KEY=...    (all services — RS256 public PEM)
#   JWT_ISSUER=http://localhost:3011/auth
#   INTERNAL_API_KEY=change-me-in-production-long-random-string
#
# Generate keys: ./scripts/generate-jwt-keys.sh
#
# After editing any .env, restart dev servers and run:  npm run check:dev
# =============================================================================

# --- web/.env (Vite; only VITE_* are exposed to the browser) ---
# VITE_API_URL=http://localhost
# Or per-service (without gateway):
# VITE_IDENTITY_API=http://localhost:3011
# VITE_PLATFORM_API=http://localhost:3012
# VITE_RECRUITMENT_API=http://localhost:3013
# VITE_NOTIFICATION_API=http://localhost:3015
# VITE_DOCUMENT_API=http://localhost:3018

# --- services/identity-service/.env ---
# PORT=3011
# DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/identity_db
# JWT_SECRET=...
# JWT_ISSUER=http://localhost:3011/auth
# JWT_EXPIRES_IN=15m
# CORS_ORIGIN=http://localhost:5173
# INTERNAL_API_KEY=...
# PLATFORM_SERVICE_URL=http://127.0.0.1:3012

# --- services/platform-service/.env ---
# PORT=3012
# DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/platform_db
# JWT_SECRET=...
# JWT_ISSUER=http://localhost:3011/auth
# CORS_ORIGIN=http://localhost:5173
# INTERNAL_API_KEY=...
# IDENTITY_SERVICE_URL=http://127.0.0.1:3011
# NOTIFICATION_SERVICE_URL=http://127.0.0.1:3015
# WEB_APP_ORIGIN=http://localhost:5173
# ONBOARDING_DEV_HINTS=true

# --- services/recruitment-service/.env ---
# PORT=3013
# DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/recruitment_db
# JWT_SECRET=...
# JWT_ISSUER=http://localhost:3011/auth
# CORS_ORIGIN=http://localhost:5173
# PLATFORM_SERVICE_URL=http://127.0.0.1:3012
# INTERNAL_API_KEY=...

# --- services/notification-service/.env ---
# PORT=3015
# DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/notifications_db
# JWT_SECRET=...
# JWT_ISSUER=http://localhost:3011/auth
# CORS_ORIGIN=http://localhost:5173
# INTERNAL_API_KEY=...
# EMAIL_FROM=noreply@ewatu.local
# SMTP_HOST=   (optional; omit to log emails to console)

# --- services/document-service/.env ---
# PORT=3018
# JWT_SECRET=...
# JWT_ISSUER=http://localhost:3011/auth
# CORS_ORIGIN=http://localhost:5173
# S3_ENDPOINT=http://127.0.0.1:19000
# S3_BUCKET=ewatu-dev
# S3_ACCESS_KEY=ewatu
# S3_SECRET_KEY=ewatu_dev_minio

# --- Docker (docker compose) — Postgres + MinIO ---
# Postgres: 127.0.0.1:15432  user ewatu / password ewatu_dev
