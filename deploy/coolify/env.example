# Copy these into Coolify → Docker Compose resource → Environment Variables
# Mark secrets as "Is Literal" if values contain $ or special characters.
#
# Required (deployment fails without these — compose uses :? syntax):
# -----------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Coolify domain, e.g. https://erp.ewatu.com
APP_URL=https://erp.example.com

# Must match identity token issuer (gateway exposes /api/v1/auth)
JWT_ISSUER=https://erp.example.com/auth

# RS256 keys — one line each with \n for newlines (run: ./scripts/generate-jwt-keys.sh)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Shared secret for service-to-service calls
INTERNAL_API_KEY=

# Postgres (bundled container; use strong passwords)
POSTGRES_USER=ewatu
POSTGRES_PASSWORD=

# MinIO / S3-compatible storage (bundled container)
MINIO_ROOT_USER=ewatu
MINIO_ROOT_PASSWORD=
S3_BUCKET=ewatu-prod

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
JWT_EXPIRES_IN=15m
S3_REGION=us-east-1
ONBOARDING_DEV_HINTS=false

# SMTP (leave SMTP_HOST empty to log emails only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=E-Watu
MAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com
