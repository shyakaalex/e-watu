generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum EmployeeType {
  INTERNAL
  OUTSOURCED
  SECONDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  SECONDMENT
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PeriodStatus {
  DRAFT
  SUBMITTED
  HR_APPROVED
  MD_APPROVED
  CLIENT_APPROVED
  FINALIZED
}

enum ApproverRole {
  HR_MANAGER
  MD
  CLIENT_ADMIN
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum DeploymentStatus {
  ACTIVE
  ON_LEAVE
  RECALLED
  TRANSFERRED
  ON_BENCH
}

enum OutsourcingEmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
}

enum SecondmentContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model PayrollConfiguration {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  clientId              String   @map("client_id")
  payFrequency          String   @default("MONTHLY") @map("pay_frequency")
  payDay                Int      @default(28) @map("pay_day")
  currency              String   @default("RWF")
  payeEnabled           Boolean  @default(true) @map("paye_enabled")
  rssbPensionEmployee   Decimal  @default(0.05) @map("rssb_pension_employee") @db.Decimal(6,4)
  rssbPensionEmployer   Decimal  @default(0.05) @map("rssb_pension_employer") @db.Decimal(6,4)
  rssbMedical           Decimal  @default(0.075) @map("rssb_medical") @db.Decimal(6,4)
  cbhiRate              Decimal  @default(0.005) @map("cbhi_rate") @db.Decimal(6,4)
  maternityLevy         Decimal  @default(0.003) @map("maternity_levy") @db.Decimal(6,4)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@map("payroll_configurations")
}

model Employee {
  id                    String           @id @default(uuid())
  tenantId              String           @map("tenant_id")
  candidateId           String?          @map("candidate_id")
  clientId              String?          @map("client_id")
  employeeType          EmployeeType     @default(OUTSOURCED) @map("employee_type")
  firstName             String           @map("first_name")
  lastName              String           @map("last_name")
  email                 String
  phone                 String?
  nationalIdEncrypted   String?          @map("national_id_encrypted")
  dateOfBirth           DateTime?        @map("date_of_birth")
  gender                String?
  nationality           String?
  department            String?
  jobTitle              String           @map("job_title")
  startDate             DateTime         @map("start_date")
  endDate               DateTime?        @map("end_date")
  employmentStatus      EmploymentStatus @default(ACTIVE) @map("employment_status")
  managerId             String?          @map("manager_id")
  basicSalary           Decimal          @default(0) @map("basic_salary") @db.Decimal(15,2)
  housingAllowance      Decimal          @default(0) @map("housing_allowance") @db.Decimal(15,2)
  transportAllowance    Decimal          @default(0) @map("transport_allowance") @db.Decimal(15,2)
  otherAllowances       Decimal          @default(0) @map("other_allowances") @db.Decimal(15,2)
  bankAccountEncrypted  String?          @map("bank_account_encrypted")
  bankName              String?          @map("bank_name")
  bankBranch            String?          @map("bank_branch")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  manager               Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  reports               Employee[]       @relation("EmployeeManager")
  contracts             EmployeeContract[]
  payrollRecords        PayrollRecord[]
  outsourcingAssignments OutsourcingAssignment[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  goals                 Goal[]
  appraisals            Appraisal[]
  feedbackNominees      FeedbackRequest[] @relation("FeedbackNominee")
  feedbackReviewers     FeedbackRequest[] @relation("FeedbackReviewer")

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, employmentStatus])
  @@map("employees")
}

model EmployeeContract {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  employeeId            String         @map("employee_id")
  contractType          ContractType   @default(PERMANENT) @map("contract_type")
  startDate             DateTime       @map("start_date")
  endDate               DateTime?      @map("end_date")
  salary                Decimal        @db.Decimal(15,2)
  currency              String         @default("RWF")
  s3Key                 String?        @map("s3_key")
  status                ContractStatus @default(ACTIVE)
  expiryAlert90Sent     Boolean        @default(false) @map("expiry_alert_90_sent")
  expiryAlert60Sent     Boolean        @default(false) @map("expiry_alert_60_sent")
  expiryAlert30Sent     Boolean        @default(false) @map("expiry_alert_30_sent")
  createdAt             DateTime       @default(now()) @map("created_at")

  employee              Employee       @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, status])
  @@map("employee_contracts")
}

model PayrollPeriod {
  id                    String       @id @default(uuid())
  tenantId              String       @map("tenant_id")
  clientId              String       @map("client_id")
  periodMonth           Int          @map("period_month")
  periodYear            Int          @map("period_year")
  status                PeriodStatus @default(DRAFT)
  preparedBy            String?      @map("prepared_by")
  submittedAt           DateTime?    @map("submitted_at")
  hrApprovedAt          DateTime?    @map("hr_approved_at")
  hrApprovedBy          String?      @map("hr_approved_by")
  mdApprovedAt          DateTime?    @map("md_approved_at")
  mdApprovedBy          String?      @map("md_approved_by")
  clientApprovedAt      DateTime?    @map("client_approved_at")
  clientApprovedBy      String?      @map("client_approved_by")
  finalizedAt           DateTime?    @map("finalized_at")
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at")

  records               PayrollRecord[]
  approvals             PayrollApproval[]
  bankFiles             BankPaymentFile[]

  @@unique([tenantId, clientId, periodMonth, periodYear])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("payroll_periods")
}

model PayrollRecord {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  periodId              String        @map("period_id")
  employeeId            String        @map("employee_id")
  basicSalary           Decimal       @map("basic_salary") @db.Decimal(15,2)
  housingAllowance      Decimal       @default(0) @map("housing_allowance") @db.Decimal(15,2)
  transportAllowance    Decimal       @default(0) @map("transport_allowance") @db.Decimal(15,2)
  otherAllowances       Decimal       @default(0) @map("other_allowances") @db.Decimal(15,2)
  grossPay              Decimal       @map("gross_pay") @db.Decimal(15,2)
  paye                  Decimal       @default(0) @db.Decimal(15,2)
  rssbEmployee          Decimal       @default(0) @map("rssb_employee") @db.Decimal(15,2)
  rssbEmployer          Decimal       @default(0) @map("rssb_employer") @db.Decimal(15,2)
  rssbMedical           Decimal       @default(0) @map("rssb_medical") @db.Decimal(15,2)
  cbhi                  Decimal       @default(0) @db.Decimal(15,2)
  maternityLevy         Decimal       @default(0) @map("maternity_levy") @db.Decimal(15,2)
  otherDeductions       Decimal       @default(0) @map("other_deductions") @db.Decimal(15,2)
  totalDeductions       Decimal       @map("total_deductions") @db.Decimal(15,2)
  netPay                Decimal       @map("net_pay") @db.Decimal(15,2)
  payslipS3Key          String?       @map("payslip_s3_key")
  payslipGeneratedAt    DateTime?     @map("payslip_generated_at")

  period                PayrollPeriod @relation(fields: [periodId], references: [id])
  employee              Employee      @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeId])
  @@index([tenantId])
  @@index([periodId])
  @@map("payroll_records")
}

model PayrollApproval {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  periodId              String         @map("period_id")
  approverRole          ApproverRole   @map("approver_role")
  approverId            String         @map("approver_id")
  action                ApprovalAction
  comments              String?
  createdAt             DateTime       @default(now()) @map("created_at")

  period                PayrollPeriod  @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@map("payroll_approvals")
}

model BankPaymentFile {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  periodId              String        @map("period_id")
  s3Key                 String?       @map("s3_key")
  generatedAt           DateTime      @default(now()) @map("generated_at")
  generatedBy           String        @map("generated_by")
  totalAmount           Decimal       @map("total_amount") @db.Decimal(15,2)
  recordCount           Int           @map("record_count")

  period                PayrollPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@map("bank_payment_files")
}

model OutsourcingAssignment {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  employeeId        String                    @map("employee_id")
  clientName        String                    @map("client_name")
  clientId          String?                   @map("client_id")
  roleName          String                    @map("role_name")
  deploymentSite    String?                   @map("deployment_site")
  employmentType    OutsourcingEmploymentType @default(FULL_TIME) @map("employment_type")
  deploymentStatus  DeploymentStatus          @default(ACTIVE) @map("deployment_status")
  startDate         DateTime                  @map("start_date")
  endDate           DateTime?                 @map("end_date")
  availabilityDate  DateTime?                 @map("availability_date")
  monthlyFee        Decimal?                  @map("monthly_fee") @db.Decimal(14, 2)
  currency          String                    @default("RWF")
  noticePeriodDays  Int                       @default(30) @map("notice_period_days")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  employee          Employee                  @relation(fields: [employeeId], references: [id])
  contracts         SecondmentContract[]
  deploymentHistory DeploymentHistory[]

  @@index([tenantId])
  @@index([tenantId, clientName])
  @@index([tenantId, deploymentStatus])
  @@map("outsourcing_assignments")
}

model SecondmentContract {
  id                  String                   @id @default(uuid())
  tenantId            String                   @map("tenant_id")
  assignmentId        String                   @map("assignment_id")
  contractRef         String?                  @map("contract_ref")
  clientName          String                   @map("client_name")
  role                String
  billingRate         Decimal                  @map("billing_rate") @db.Decimal(14, 2)
  currency            String                   @default("RWF")
  workingHoursPerWeek Int                      @default(40) @map("working_hours_per_week")
  noticePeriodDays    Int                      @default(30) @map("notice_period_days")
  governingLaw        String?                  @map("governing_law")
  startDate           DateTime                 @map("start_date")
  endDate             DateTime?                @map("end_date")
  renewalDate         DateTime?                @map("renewal_date")
  status              SecondmentContractStatus @default(ACTIVE)
  terminationReason   String?                  @map("termination_reason")
  terminatedAt        DateTime?                @map("terminated_at")
  terminatedBy        String?                  @map("terminated_by")
  alert90Sent         Boolean                  @default(false) @map("alert_90_sent")
  alert60Sent         Boolean                  @default(false) @map("alert_60_sent")
  alert30Sent         Boolean                  @default(false) @map("alert_30_sent")
  s3Key               String?                  @map("s3_key")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  createdBy           String?                  @map("created_by")

  assignment          OutsourcingAssignment    @relation(fields: [assignmentId], references: [id])
  amendments          ContractAmendment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assignmentId])
  @@map("secondment_contracts")
}

model ContractAmendment {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  contractId   String             @map("contract_id")
  changedBy    String             @map("changed_by")
  reason       String
  changesSummary String           @map("changes_summary")
  snapshotJson Json               @map("snapshot_json")
  createdAt    DateTime           @default(now()) @map("created_at")

  contract     SecondmentContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_amendments")
}

model DeploymentHistory {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  assignmentId String                @map("assignment_id")
  clientName   String                @map("client_name")
  roleName     String                @map("role_name")
  startDate    DateTime              @map("start_date")
  endDate      DateTime?             @map("end_date")
  reason       String?
  createdAt    DateTime              @default(now()) @map("created_at")

  assignment   OutsourcingAssignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
  @@map("deployment_history")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String   // e.g. ANNUAL, SICK, MATERNITY, PATERNITY, UNPAID
  description String?
  defaultDays Decimal  @map("default_days") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model LeaveRequest {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  employeeId      String      @map("employee_id")
  leaveTypeId     String      @map("leave_type_id")
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  numberOfDays    Decimal     @map("number_of_days") @db.Decimal(5, 2)
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedById    String?     @map("approved_by_id")
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_requests")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  leaveTypeId   String    @map("leave_type_id")
  year          Int
  allocatedDays Decimal   @map("allocated_days") @db.Decimal(5, 2)
  usedDays      Decimal   @default(0) @map("used_days") @db.Decimal(5, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@map("leave_balances")
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AppraisalStatus {
  SELF_ASSESSMENT
  MANAGER_REVIEW
  HR_REVIEW
  COMPLETED
}

enum FeedbackRelationship {
  PEER
  SUBORDINATE
  MANAGER
}

enum FeedbackStatus {
  PENDING
  COMPLETED
  DECLINED
}

model AppraisalCycle {
  id                      String        @id @default(uuid())
  tenantId                String        @map("tenant_id")
  clientId                String?       @map("client_id")
  name                    String
  frequency               String        @default("ANNUAL")
  startDate               DateTime      @map("start_date")
  endDate                 DateTime      @map("end_date")
  selfAssessmentDeadline  DateTime      @map("self_assessment_deadline")
  managerReviewDeadline   DateTime      @map("manager_review_deadline")
  hrValidationDeadline    DateTime      @map("hr_validation_deadline")
  status                  CycleStatus   @default(DRAFT)
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  appraisals              Appraisal[]
  goals                   Goal[]

  @@index([tenantId])
  @@map("appraisal_cycles")
}

model CompetencyFramework {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  competencies Competency[]

  @@index([tenantId])
  @@map("competency_frameworks")
}

model Competency {
  id          String              @id @default(uuid())
  frameworkId String              @map("framework_id")
  name        String
  description String?
  weight      Decimal             @default(1.0) @db.Decimal(5, 2)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  framework   CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  ratings     AppraisalCompetencyRating[]

  @@map("competencies")
}

model Goal {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  employeeId        String         @map("employee_id")
  appraisalCycleId  String         @map("appraisal_cycle_id")
  title             String
  description       String?
  target            String
  measurementMethod String         @map("measurement_method")
  weight            Decimal        @db.Decimal(5, 2)
  deadline          DateTime
  status            GoalStatus     @default(DRAFT)
  progress          Decimal        @default(0.0) @db.Decimal(5, 2)
  managerComment    String?        @map("manager_comment")
  objectiveId       String?        @map("objective_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle             AppraisalCycle @relation(fields: [appraisalCycleId], references: [id], onDelete: Cascade)
  ratings           AppraisalGoalRating[]

  @@index([tenantId])
  @@index([employeeId])
  @@map("goals")
}

model GoalTemplate {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  roleType          String?  @map("role_type")
  title             String
  description       String?
  target            String
  measurementMethod String   @map("measurement_method")
  weight            Decimal  @default(20.0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("goal_templates")
}

model Appraisal {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  employeeId        String         @map("employee_id")
  cycleId           String         @map("cycle_id")
  status            AppraisalStatus @default(SELF_ASSESSMENT)
  selfScore         Decimal?       @map("self_score") @db.Decimal(5, 2)
  managerScore      Decimal?       @map("manager_score") @db.Decimal(5, 2)
  hrScore           Decimal?       @map("hr_score") @db.Decimal(5, 2)
  finalScore        Decimal?       @map("final_score") @db.Decimal(5, 2)
  managerAdjustment Decimal?       @map("manager_adjustment") @db.Decimal(5, 2)
  selfComment       String?        @map("self_comment")
  managerComment    String?        @map("manager_comment")
  hrComment         String?        @map("hr_comment")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle             AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  goalRatings       AppraisalGoalRating[]
  competencyRatings AppraisalCompetencyRating[]
  feedbackRequests  FeedbackRequest[]

  @@unique([employeeId, cycleId])
  @@index([tenantId])
  @@map("appraisals")
}

model AppraisalGoalRating {
  id             String    @id @default(uuid())
  appraisalId    String    @map("appraisal_id")
  goalId         String    @map("goal_id")
  selfRating     Decimal?  @map("self_rating") @db.Decimal(5, 2)
  selfComment    String?   @map("self_comment")
  managerRating  Decimal?  @map("manager_rating") @db.Decimal(5, 2)
  managerComment String?   @map("manager_comment")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  appraisal      Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  goal           Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, goalId])
  @@map("appraisal_goal_ratings")
}

model AppraisalCompetencyRating {
  id             String     @id @default(uuid())
  appraisalId    String     @map("appraisal_id")
  competencyId   String     @map("competency_id")
  selfRating     Decimal?   @map("self_rating") @db.Decimal(5, 2)
  selfComment    String?    @map("self_comment")
  managerRating  Decimal?   @map("manager_rating") @db.Decimal(5, 2)
  managerComment String?    @map("manager_comment")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  appraisal      Appraisal  @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  competency     Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, competencyId])
  @@map("appraisal_competency_ratings")
}

model FeedbackRequest {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  appraisalId  String               @map("appraisal_id")
  employeeId   String               @map("employee_id")
  reviewerId   String               @map("reviewer_id")
  relationship FeedbackRelationship
  status       FeedbackStatus       @default(PENDING)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  appraisal    Appraisal            @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  employee     Employee             @relation("FeedbackNominee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee             @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  response     FeedbackResponse?

  @@index([tenantId])
  @@index([appraisalId])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id                String          @id @default(uuid())
  feedbackRequestId String          @unique @map("feedback_request_id")
  anonymized        Boolean         @default(true)
  competencyRatings Json
  generalComment    String?         @map("general_comment")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  request           FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)

  @@map("feedback_responses")
}

model SecurityAuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  payload    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("security_audit_logs")
}
