generator client {
  provider = "prisma-client-js"
  // Explicit local output so this service's Prisma client is never shadowed by (or shadows)
  // another service's generated client at the npm workspace root -- see the shared
  // node_modules/@prisma/client hoisting issue this fixes.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tenantId  String?   @map("tenant_id")
  title     String
  body      String
  channel   String    @default("in_app")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([tenantId])
  @@map("notifications")
}
