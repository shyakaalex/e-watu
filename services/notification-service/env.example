PORT=3015
SERVICE_NAME=notification-service
DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/notifications_db
JWT_PUBLIC_KEY=<paste-public-pem-one-line-with-\n-escapes>
JWT_ISSUER=http://localhost:3011/auth
CORS_ORIGIN=http://localhost:5173
INTERNAL_API_KEY=change-me-in-production-long-random-string

# Email / SMTP
# Required for real email sending in production
# Leave SMTP_HOST empty to use console logging only (dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender details (falls back to EMAIL_FROM if MAIL_FROM_ADDRESS unset)
MAIL_FROM_NAME=E-Watu
MAIL_FROM_ADDRESS=noreply@ewatu.com
EMAIL_FROM=noreply@ewatu.local
