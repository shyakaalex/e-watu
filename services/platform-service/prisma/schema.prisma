// platform-service — tenant registry (EWatu §2 multi-tenancy)
generator client {
  provider = "prisma-client-js"
  // Explicit local output so this service's Prisma client is never shadowed by (or shadows)
  // another service's generated client at the npm workspace root -- see the shared
  // node_modules/@prisma/client hoisting issue this fixes.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING_ACTIVATION
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
  REJECTED
  ARCHIVED
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  slug               String       @unique
  status             TenantStatus @default(PENDING_ACTIVATION)
  plan               String?
  country            String?   @default("RW")
  businessEmail      String?   @map("business_email")
  phone              String?
  ownerUserId        String?   @map("owner_user_id")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  rejectionReason    String?   @map("rejection_reason")
  logoUrl            String?   @map("logo_url")
  primaryColor       String?   @default("#00466c") @map("primary_color")
  secondaryColor     String?   @map("secondary_color")
  accentColor        String?   @default("#f5911e") @map("accent_color")
  backgroundColor    String?   @map("background_color")
  textColor          String?   @map("text_color")
  website            String?
  baseCurrency       String?   @default("RWF") @map("base_currency")
  fiscalYearStartMonth Int?    @default(1) @map("fiscal_year_start_month")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([status])
}
