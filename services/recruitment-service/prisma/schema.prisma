// recruitment-service — jobs, candidates, applications, interviews

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  title       String
  description String?
  department  String?
  location    String?
  type        String    @default("FULL_TIME")
  status      String    @default("DRAFT")
  salaryMin   Int?      @map("salary_min")
  salaryMax   Int?      @map("salary_max")
  currency    String    @default("RWF")
  headcount   Int       @default(1)
  postedAt    DateTime? @map("posted_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  applications Application[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("jobs")
}

model Candidate {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  phone        String?
  cvUrl        String?  @map("cv_url")
  linkedinUrl  String?  @map("linkedin_url")
  currentTitle String?  @map("current_title")
  source       String   @default("DIRECT")
  notes        String?
  tags         String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model Application {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  jobId       String   @map("job_id")
  candidateId String   @map("candidate_id")
  stage       String   @default("APPLIED")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  job        Job        @relation(fields: [jobId], references: [id])
  candidate  Candidate  @relation(fields: [candidateId], references: [id])
  interviews Interview[]

  @@unique([tenantId, jobId, candidateId])
  @@index([tenantId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model Interview {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  applicationId  String   @map("application_id")
  scheduledAt    DateTime @map("scheduled_at")
  durationMin    Int      @default(60) @map("duration_min")
  type           String   @default("VIDEO")
  interviewerIds String[] @map("interviewer_ids")
  status         String   @default("SCHEDULED")
  feedback       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([applicationId])
  @@map("interviews")
}
