// recruitment-service — jobs, candidates, applications, interviews, offers, placements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  title          String
  description    String?
  department     String?
  location       String?
  type           String    @default("FULL_TIME")
  status         String    @default("DRAFT")
  priority       String    @default("STANDARD")
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  currency       String    @default("RWF")
  headcount      Int       @default(1)
  deadline       DateTime?
  requiredSkills String[]  @default([]) @map("required_skills")
  qualifications String?
  clientId       String?   @map("client_id")
  clientName     String?   @map("client_name")
  consultantId   String?   @map("consultant_id")
  feeType        String?   @map("fee_type")
  feeValue       Float?    @map("fee_value")
  postedAt       DateTime? @map("posted_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  applications Application[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("jobs")
}

model Candidate {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  email                 String
  phone                 String?
  cvUrl                 String?  @map("cv_url")
  linkedinUrl           String?  @map("linkedin_url")
  currentTitle          String?  @map("current_title")
  source                String   @default("MANUAL")
  notes                 String?
  tags                  String[]
  archived              Boolean  @default(false)

  // Extended profile fields
  dob                   DateTime? @map("dob")
  gender                String?
  nationality           String?
  city                  String?
  country               String?
  contactPreference     String?   @map("contact_preference")
  communicationLanguage String?   @default("English") @map("communication_language")
  currentEmployer       String?   @map("current_employer")
  yearsExperience       Int?      @map("years_experience")
  employmentStatus      String?   @map("employment_status")
  summary               String?
  salaryExpMin          Int?      @map("salary_exp_min")
  salaryExpMax          Int?      @map("salary_exp_max")
  salaryCurrency        String?   @default("RWF") @map("salary_currency")
  availability          String?   @default("IMMEDIATE")
  availableFrom         DateTime? @map("available_from")
  status                String    @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications    Application[]
  workHistory     WorkHistory[]
  educations      Education[]
  languages       CandidateLanguage[]
  documents       CandidateDocument[]
  recruiterNotes  RecruiterNote[]
  activities      CandidateActivity[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model Application {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  jobId           String   @map("job_id")
  candidateId     String   @map("candidate_id")
  stage           String   @default("APPLIED")
  notes           String?
  rejectionReason String?  @map("rejection_reason")
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job          Job            @relation(fields: [jobId], references: [id])
  candidate    Candidate      @relation(fields: [candidateId], references: [id])
  interviews   Interview[]
  stageHistory StageHistory[]
  offers       Offer[]

  @@unique([tenantId, jobId, candidateId])
  @@index([tenantId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model StageHistory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  applicationId String   @map("application_id")
  fromStage     String?  @map("from_stage")
  toStage       String   @map("to_stage")
  changedBy     String   @map("changed_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([applicationId])
  @@map("stage_history")
}

model Interview {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  applicationId  String   @map("application_id")
  scheduledAt    DateTime @map("scheduled_at")
  durationMin    Int      @default(60) @map("duration_min")
  type           String   @default("VIDEO")
  interviewerIds String[] @map("interviewer_ids")
  locationOrLink String?  @map("location_or_link")
  status         String   @default("SCHEDULED")
  outcome        String?
  feedback       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  application Application          @relation(fields: [applicationId], references: [id])
  scorecards  InterviewScorecard[]

  @@index([tenantId])
  @@index([applicationId])
  @@map("interviews")
}

model InterviewScorecard {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  interviewId String   @map("interview_id")
  competency  String
  score       Int
  notes       String?
  submittedBy String   @map("submitted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  interview Interview @relation(fields: [interviewId], references: [id])

  @@index([tenantId])
  @@index([interviewId])
  @@map("interview_scorecards")
}

model Offer {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  applicationId   String    @map("application_id")
  jobId           String    @map("job_id")
  candidateId     String    @map("candidate_id")
  salary          Float
  currency        String    @default("RWF")
  startDate       DateTime? @map("start_date")
  probationDays   Int       @default(90) @map("probation_days")
  status          String    @default("DRAFT")
  offerLetterUrl  String?   @map("offer_letter_url")
  signatureStatus String?   @map("signature_status")
  counterNotes    String?   @map("counter_notes")
  rejectionReason String?   @map("rejection_reason")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id])
  placement   Placement?

  @@index([tenantId])
  @@index([applicationId])
  @@index([jobId])
  @@index([candidateId])
  @@map("offers")
}

model Placement {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  offerId       String   @unique @map("offer_id")
  jobId         String   @map("job_id")
  candidateId   String   @map("candidate_id")
  clientId      String?  @map("client_id")
  clientName    String?  @map("client_name")
  roleName      String   @map("role_name")
  startDate     DateTime @map("start_date")
  salary        Float
  currency      String   @default("RWF")
  reportingLine String?  @map("reporting_line")
  consultantId  String?  @map("consultant_id")
  invoiceStatus String   @default("PENDING") @map("invoice_status")
  createdAt     DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([tenantId])
  @@index([jobId])
  @@index([candidateId])
  @@map("placements")
}

model WorkHistory {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  candidateId      String    @map("candidate_id")
  employer         String
  title            String
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  isCurrent        Boolean   @default(false) @map("is_current")
  responsibilities String?
  createdAt        DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("work_history")
}

model Education {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  candidateId String    @map("candidate_id")
  institution String
  degree      String?
  field       String?
  startYear   Int?      @map("start_year")
  endYear     Int?      @map("end_year")
  createdAt   DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("educations")
}

model CandidateLanguage {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  candidateId String   @map("candidate_id")
  language    String
  proficiency String   @default("CONVERSATIONAL")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_languages")
}

model CandidateDocument {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  candidateId String   @map("candidate_id")
  fileName    String   @map("file_name")
  fileKey     String   @map("file_key")
  fileUrl     String   @map("file_url")
  mimeType    String   @default("application/pdf") @map("mime_type")
  version     Int      @default(1)
  label       String   @default("CV")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_documents")
}

model RecruiterNote {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  candidateId String   @map("candidate_id")
  content     String
  authorId    String   @map("author_id")
  authorName  String   @map("author_name")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("recruiter_notes")
}

model CandidateActivity {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  candidateId String   @map("candidate_id")
  type        String
  description String
  metadata    Json?
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([tenantId, candidateId])
  @@map("candidate_activities")
}
