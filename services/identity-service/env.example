PORT=3011
SERVICE_NAME=identity-service
DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/identity_db

# Generate keys:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=<paste-private-pem-one-line-with-\n-escapes>
JWT_PUBLIC_KEY=<paste-public-pem-one-line-with-\n-escapes>

JWT_ISSUER=http://localhost:3011/auth
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
INTERNAL_API_KEY=change-me-in-production-long-random-string
