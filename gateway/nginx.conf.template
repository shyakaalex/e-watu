worker_processes auto;

events {
  worker_connections 1024;
}

http {
  log_format main '$remote_addr - $request_id [$time_local] "$request" $status $body_bytes_sent';
  access_log /var/log/nginx/access.log main;

  upstream identity {
    server ${IDENTITY_SERVICE_URL};
  }

  upstream platform {
    server ${PLATFORM_SERVICE_URL};
  }

  upstream recruitment {
    server ${RECRUITMENT_SERVICE_URL};
  }

  upstream notification {
    server ${NOTIFICATION_SERVICE_URL};
  }

  upstream documents {
    server ${DOCUMENT_SERVICE_URL};
  }

  server {
    listen 80;
    server_name _;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Correlation-ID $request_id;
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location = /health {
      default_type application/json;
      return 200 '{"status":"ok","service":"e-watu-gateway"}';
    }

    location /api/v1/auth {
      proxy_pass http://identity;
    }

    location /api/v1/me {
      proxy_pass http://identity;
    }

    location /api/v1/users {
      proxy_pass http://identity;
    }

    location /api/v1/identity {
      proxy_pass http://identity;
    }

    location /api/v1/internal/dispatch {
      proxy_pass http://notification;
    }

    location /api/v1/internal/tenants {
      proxy_pass http://platform;
    }

    location /api/v1/internal/provision-tenant-owner {
      proxy_pass http://identity;
    }

    location /api/v1/internal {
      proxy_pass http://identity;
    }

    location /api/v1/platform {
      proxy_pass http://platform;
    }

    location /api/v1/tenants {
      proxy_pass http://platform;
    }

    location /api/v1/onboarding {
      proxy_pass http://platform;
    }

    location /api/v1/my {
      proxy_pass http://platform;
    }

    location /api/v1/public/tenants {
      proxy_pass http://platform;
    }

    location /api/v1/jobs {
      proxy_pass http://recruitment;
    }

    location /api/v1/candidates {
      proxy_pass http://recruitment;
    }

    location /api/v1/applications {
      proxy_pass http://recruitment;
    }

    location /api/v1/interviews {
      proxy_pass http://recruitment;
    }

    location /api/v1/offers {
      proxy_pass http://recruitment;
    }

    location /api/v1/placements {
      proxy_pass http://recruitment;
    }

    location /api/v1/public/ {
      proxy_pass http://recruitment;
    }

    location /api/v1/recruitment {
      proxy_pass http://recruitment;
    }

    location /api/v1/document {
      proxy_pass http://documents;
    }

    location /api/v1/notifications {
      proxy_pass http://notification;
    }
  }
}
