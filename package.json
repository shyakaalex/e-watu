{
  "name": "ewatu-erp",
  "private": true,
  "description": "E-Watu HR ERP — microservices (from EWatu v1.1 spec)",
  "scripts": {
    "build:common-auth": "npm run build --prefix libs/common-auth",
    "build:platform": "npm run build --prefix services/platform-service",
    "build:identity": "npm run build --prefix services/identity-service",
    "build:document": "npm run build --prefix services/document-service",
    "build:notification": "npm run build --prefix services/notification-service",
    "build:all": "npm run build:common-auth && npm run build:platform && npm run build:identity && npm run build:document && npm run build:notification",
    "dev:platform": "npm run start:dev --prefix services/platform-service",
    "dev:identity": "npm run start:dev --prefix services/identity-service",
    "dev:document": "npm run start:dev --prefix services/document-service",
    "dev:notification": "npm run start:dev --prefix services/notification-service",
    "dev:recruitment": "npm run start:dev --prefix services/recruitment-service",
    "dev:web": "npm run dev --prefix web",
    "build:recruitment": "npm run build --prefix services/recruitment-service",
    "build:web": "npm run build --prefix web",
    "build:all": "npm run build:common-auth && npm run build:platform && npm run build:identity && npm run build:document && npm run build:notification && npm run build:recruitment",
    "db:up": "docker compose up -d",
    "db:migrate:identity": "npm run prisma:migrate --prefix services/identity-service",
    "db:migrate:recruitment": "npm run prisma:migrate --prefix services/recruitment-service"
  },
  "engines": {
    "node": ">=20"
  }
}
