# Coolify environment variables — copy names into each service in the dashboard.
# Values differ for staging (staging.hcsolutions.site) vs production (app.hcsolutions.site).

# ── Shared (set on every backend service) ───────────────────────────────────
JWT_PUBLIC_KEY=
JWT_ISSUER=                    # e.g. https://api.staging.hcsolutions.site/auth
NODE_ENV=production
CORS_ORIGIN=                   # e.g. https://staging.hcsolutions.site
INTERNAL_API_KEY=

# ── identity-service ──────────────────────────────────────────────────────────
IDENTITY_DATABASE_URL=
JWT_PRIVATE_KEY=
JWT_EXPIRES_IN=15m
REFRESH_TTL_MS=604800000
BCRYPT_ROUNDS=12
PLATFORM_SERVICE_URL=          # internal URL, e.g. http://platform-service:3012

# ── platform-service ──────────────────────────────────────────────────────────
PLATFORM_DATABASE_URL=
IDENTITY_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
WEB_APP_ORIGIN=
ONBOARDING_DEV_HINTS=false

# ── recruitment-service ───────────────────────────────────────────────────────
RECRUITMENT_DATABASE_URL=
PLATFORM_SERVICE_URL=

# ── payroll-service ───────────────────────────────────────────────────────────
PAYROLL_DATABASE_URL=

# ── notification-service ──────────────────────────────────────────────────────
NOTIFICATION_DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=E-Watu
MAIL_FROM_ADDRESS=
EMAIL_FROM=

# ── document-service ───────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ── gateway (public API) — used by gateway/docker-entrypoint.sh (envsubst) ─────
# Defaults match durable Coolify network aliases. Override HOST with Coolify
# resource UUID if aliases are not configured.
IDENTITY_SERVICE_HOST=identity-service
IDENTITY_SERVICE_PORT=3011
PLATFORM_SERVICE_HOST=platform-service
PLATFORM_SERVICE_PORT=3012
RECRUITMENT_SERVICE_HOST=recruitment-service
RECRUITMENT_SERVICE_PORT=3013
TALENT_POOL_SERVICE_HOST=talent-pool-service
TALENT_POOL_SERVICE_PORT=3014
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=3015
PAYROLL_SERVICE_HOST=payroll-service
PAYROLL_SERVICE_PORT=3016
DOCUMENT_SERVICE_HOST=document-service
DOCUMENT_SERVICE_PORT=3018
LENDING_SERVICE_HOST=lending-service
LENDING_SERVICE_PORT=3021

# ── web (public frontend) — build argument ────────────────────────────────────
VITE_API_URL=                  # Gateway URL, e.g. https://api.staging.hcsolutions.site
                               # Do NOT append /api — the app adds /api/v1
